# כתובת האתר — משמשת לקישורים במיילים (למשל איפוס סיסמה)
APP_URL=http://localhost:3000

# שליחת מיילים דרך Resend (https://resend.com). בלי שני אלה המיילים "מסומלצים":
# נרשמים ביומן ומודפסים ללוג השרת, אבל לא נשלחים.
RESEND_API_KEY=
EMAIL_FROM="שם העסק <billing@your-domain.co.il>"

# זיהוי אוטומטי של קבלות עם Claude (https://platform.claude.com). בלי מפתח — הקבלות נשמרות והפרטים ממולאים ידנית.
ANTHROPIC_API_KEY=

# נתיב ל־Chromium להפקת PDF (לא נדרש כשמותקן דרך Playwright)
CHROMIUM_PATH=

# מיקום מסד הנתונים המקומי (PGlite). ברירת מחדל: .data/pglite
PGLITE_DATA_DIR=

# מסד נתונים בייצור: Supabase (או כל Postgres). בלי DATABASE_URL משתמשים ב־PGlite מקומי.
# הכתובת: Supabase → Connect → Transaction pooler (פורט 6543), בתוספת ?sslmode=verify-full.
DATABASE_URL=
# external = הסכמה מנוהלת מבחוץ (הטבלאות נוצרו דרך כלי ה־MCP של Supabase); בלי זה המיגרציות רצות באתחול.
DATABASE_MIGRATIONS=external
# תעודת השורש של השרת (תוכן קובץ PEM) אם אינה חתומה על ידי CA ציבורי — Supabase → Database settings → SSL certificate
DATABASE_SSL_CA=
